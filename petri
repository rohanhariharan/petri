def diff_histories(a, b):
    """Compare two value histories (list of record dicts). Returns (changed_lines, status).

    status: "changed" if any position differs, else "unchanged" (including
    when histories are empty/equal in length and equal in value).
    """
    changed = []
    n = max(len(a), len(b))
    changed_any = False
    for i in range(n):
        av = a[i] if i < len(a) else None
        bv = b[i] if i < len(b) else None
        av_val = av.get("v") if isinstance(av, dict) else av
        bv_val = bv.get("v") if isinstance(bv, dict) else bv
        if av_val == bv_val:
            continue
        changed_any = True
        if av_val is not None and bv_val is not None and _same_container_type(av_val, bv_val):
            sub = deep_value_diff(av_val, bv_val)
            if sub:
                changed.append(", ".join(sub))
            else:
                changed.append("{} → {}".format(fmt_value(av_val), fmt_value(bv_val)))
        else:
            left = fmt_value(av_val) if av_val is not None else "(none)"
            right = fmt_value(bv_val) if bv_val is not None else "(none)"
            changed.append("{} → {}".format(left, right))
    return changed, ("changed" if changed_any else "unchanged")


def _same_container_type(x, y):
    return x.get("type") in ("list", "dict") and x.get("type") == y.get("type")


def _final_numeric(snap):
    """Return (float value, kind) for numeric leaf snapshots, else None."""
    if snap is None:
        return None
    v = snap.get("v")
    if not isinstance(v, dict):
        return None
    if v.get("type") in ("int", "float"):
        try:
            return float(v["value"])
        except (TypeError, ValueError):
            return None
    return None


def cfu_metrics(hist_a, hist_b):
    """Numeric change metrics between two value histories.

    Returns dict with:
      events  - total value changes recorded across both runs (colony-forming units)
      changes - count of positions that differ (gram of the change)
      delta   - (final_a - final_b) for numeric leaf, else None
      pct     - percent change if numeric and base != 0, else None
      status  - changed | unchanged | added | removed
    """
    a = hist_a or []
    b = hist_b or []
    events = len(a) + len(b)
    if not a or not b:
        status = "removed" if a and not b else ("added" if not a and b else "unchanged")
        # a variable present in only one run counts as one discrete change
        changes = 1 if status in ("added", "removed") else 0
        return {"events": events, "changes": changes, "delta": None, "pct": None,
                "status": status}
    diff_lines, status = diff_histories(a, b)
    changes = len(diff_lines)
    fa = _final_numeric(a[-1])
    fb = _final_numeric(b[-1])
    delta = pct = None
    if fa is not None and fb is not None:
        delta = fb - fa
        if abs(fa) > 1e-12:
            pct = (delta / abs(fa)) * 100.0
    return {"events": events, "changes": changes, "delta": delta, "pct": pct,
            "status": status}


def _fmt_num(x):
    if x is None:
        return "-"
    if abs(x) >= 1e6 or abs(x) < 1e-4:
        return "{:.2e}".format(x)
    return "{:.4g}".format(x)


def print_cfu(run_a, run_b):
    print("CFU of Culture #{} vs Culture #{}".format(run_a["number"], run_b["number"]))
    print("(colony-forming units — a numeric measure of change)")
    print()

    ha = run_a.get("variables", {})
    hb = run_b.get("variables", {})
    names = sorted(set(list(ha.keys()) + list(hb.keys())))

    if not names:
        print("(no variables to compare)")
        return

    #                Variable        CFU   Δpos  Δval    Δ%
    header = "{:<18} {:>6} {:>6} {:>12} {:>10}".format(
        "Variable", "CFU", "Δpos", "Δ magnitude", "Δ %")
    print(header)
    print("-" * len(header))
    for name in names:
        m = cfu_metrics(ha.get(name), hb.get(name))
        del_show = _fmt_num(m["delta"]) if m["delta"] is not None else "-"
        pct_show = ("{:+.2f}%".format(m["pct"]) if m["pct"] is not None else "-")
        print("{:<18} {:>6} {:>6} {:>12} {:>10}".format(
            name, m["events"], m["changes"], del_show, pct_show))
    print()
    print("CFU = total value changes  ·  Δpos = differing positions  ·  "
          "Δ magnitude/Δ% = final-value change")





def deep_value_diff(a, b, path=""):
    """Return lines describing fine-grained differences inside list/dict values.

    `a`, `b` are typed snapshots (dicts with "type"/"value"). Produces lines
    like "config['lr']: 0.1 → 0.01" or "items[1]: 2 → 9".
    """
    if a["type"] == "list" and b["type"] == "list":
        out = []
        n = max(len(a["value"]), len(b["value"]))
        for i in range(n):
            av = a["value"][i] if i < len(a["value"]) else None
            bv = b["value"][i] if i < len(b["value"]) else None
            if av == bv:
                continue
            at = av or {"type": "repr", "value": "(none)"}
            bt = bv or {"type": "repr", "value": "(none)"}
            if av is not None and bv is not None and _same_container_type(av, bv):
                inner = deep_value_diff(av, bv, path="")
                if inner:
                    out.append("{}[{}] {{{}}}".format(path, i, ", ".join(inner)))
                    continue
            out.append("{}[{}]: {} → {}".format(path, i, fmt_value(at), fmt_value(bt)))
        return out
    if a["type"] == "dict" and b["type"] == "dict":
        out = []
        keys = list(a["value"].keys())
        for k in b["value"].keys():
            if k not in keys:
                keys.append(k)
        for k in keys:
            av = a["value"].get(k)
            bv = b["value"].get(k)
            if av == bv:
                continue
            at = av or {"type": "repr", "value": "(none)"}
            bt = bv or {"type": "repr", "value": "(none)"}
            if _same_container_type(at, bt):
                inner = deep_value_diff(at, bt)
                if inner:
                    out.append("{}{} {{{}}}".format(path, k, ", ".join(inner)))
                    continue
            out.append("{}{}: {} → {}".format(path, k, fmt_value(at), fmt_value(bt)))
        return out
    return []


def print_compare(run_a, run_b):
    print("Gram stain of Culture #{} vs Culture #{}".format(run_a["number"], run_b["number"]))
    print()

    ha = run_a.get("variables", {})
    hb = run_b.get("variables", {})

    changed_vars = {}
    unchanged_vars = {}
    added = {}
    removed = {}

    for name in ha:
        if name in hb:
            lines, status = diff_histories(ha[name], hb[name])
            if status == "changed":
                changed_vars[name] = lines
            else:
                unchanged_vars[name] = ha[name][-1]["v"]
        else:
            removed[name] = ha[name][-1]["v"]

    for name in hb:
        if name not in ha:
