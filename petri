#!/usr/bin/env python3
"""
petri - grow, observe, compare.

Instrument a Python program, record its variable history over a run (a
"culture"), save each culture, list / scope them, and run a differential Gram
test (gram) to see what actually changed between two experiments.

Single-file CLI. Requires only the Python stdlib. Stores data under ~/.petri.
"""
import ast
import datetime
import json
import os
import subprocess
import sys
import time
import uuid as uuidmod

DATA_DIR = os.path.expanduser("~/.petri")
RUNS_DIR = os.path.join(DATA_DIR, "runs")
INDEX_FILE = os.path.join(DATA_DIR, "index.json")

# ---------------------------------------------------------------------------
# Value serialization
# ---------------------------------------------------------------------------

# Type names we understand and record. Anything else is skipped (or repr'd).
SCALAR_TYPES = (int, float, str, bool, type(None))

_MAX_DEPTH = 20


def snapshot_value(value, depth=0):
    """Produce a serializable, type-tagged snapshot of a value. Best effort.

    Returns (typed dict, ok) where ok=False means "don't record this variable".
    Unsupported types come back as a repr string so we don't silently lose them.
    """
    if isinstance(value, bool):
        return {"type": "bool", "value": bool(value)}, True
    if isinstance(value, int):
        return {"type": "int", "value": int(value)}, True
    if isinstance(value, float):
        return {"type": "float", "value": float(value)}, True
    if isinstance(value, str):
        return {"type": "str", "value": str(value)}, True
    if value is None:
        return {"type": "None", "value": None}, True

    if isinstance(value, list) or isinstance(value, tuple):
        if depth >= _MAX_DEPTH:
            return {"type": "list", "value": [repr(value)]}, True
        items = []
        for it in value:
            snap, _ = snapshot_value(it, depth + 1)
            items.append(snap)
        return {"type": "list", "value": items}, True

    if isinstance(value, dict):
        if depth >= _MAX_DEPTH:
            return {"type": "dict", "value": {"<repr>": repr(value)}}, True
        items = {}
        try:
            iterable = value.items()
        except AttributeError:
            return {"type": "dict", "value": {"<repr>": repr(value)}}, True
        for k, v in iterable:
            vsnap, _ = snapshot_value(v, depth + 1)
            if isinstance(k, str):
                key = k
            elif isinstance(k, (int, float, bool)) or k is None:
                key = repr(k)
            else:
                key = repr(k)
            items[key] = vsnap
        return {"type": "dict", "value": items}, True

    # Unsupported / arbitrary object. Keep it as a repr so the diff still works
    # at a coarse level.
    return {"type": "repr", "value": repr(value)}, False


# ---------------------------------------------------------------------------
# Recording target (injected into the instrumented program, runs in a subprocess)
# ---------------------------------------------------------------------------

# The instrumented program runs in its own subprocess (so os._exit / quit /
# sys.argv all behave exactly like `python main.py`). To survive even a hard
# os._exit() — which bypasses every Python cleanup hook — the recorder appends
# each change to a JSONL log file the moment it happens. The parent process
# reads that log back after the child exits.
PRELUDE = """
import json, os, sys, time as _t

_PETRI_LOG = os.environ['PETRI_LOG']
_PETRI_START = float(os.environ['PETRI_START'])
# Behave like a real `python <program>` invocation:
sys.argv = [os.environ['PETRI_PROGRAM']] + json.loads(os.environ.get('PETRI_ARGS', '[]'))

# Optional variable filters (glob patterns), injected by the parent.
#   _TRACK   -> if set, only record names matching one of these
#   _IGNORE  -> if set, skip names matching any of these (empty => no filter)
_TRACK = json.loads(os.environ.get('PETRI_TRACK', '[]'))
_IGNORE = json.loads(os.environ.get('PETRI_IGNORE', '[]'))

def _matches(patterns, name):
    for p in patterns:
        if p.endswith('*'):
            if name.startswith(p[:-1]):
                return True
        elif p == name:
            return True
    return False

def _allowed(name):
    if _IGNORE and _matches(_IGNORE, name):
        return False
    if _TRACK and not _matches(_TRACK, name):
        return False
    return True

def _snapshot(value, depth=0):
    _MAX = 20
    if isinstance(value, bool):
        return {"type": "bool", "value": bool(value)}
    if isinstance(value, int):
        return {"type": "int", "value": int(value)}
    if isinstance(value, float):
        return {"type": "float", "value": float(value)}
    if isinstance(value, str):
        return {"type": "str", "value": str(value)}
    if value is None:
        return {"type": "None", "value": None}
    if isinstance(value, (list, tuple)):
        if depth >= _MAX:
            return {"type": "list", "value": [repr(value)]}
        return {"type": "list", "value": [_snapshot(it, depth + 1) for it in value]}
    if isinstance(value, dict):
        if depth >= _MAX:
            return {"type": "dict", "value": {"<repr>": repr(value)}}
        out = {}
        try:
            iterable = value.items()
        except AttributeError:
            return {"type": "dict", "value": {"<repr>": repr(value)}}
        for k, v in iterable:
            kk = k if isinstance(k, str) else repr(k)
            out[kk] = _snapshot(v, depth + 1)
        return {"type": "dict", "value": out}
    return None

def __lab_record(name, value):
    if not _allowed(name):
        return
    snap = _snapshot(value)
    if snap is None:
        return
    rec = {"n": name, "v": snap, "t": (_t.monotonic() - _PETRI_START) * 1000.0}
    with open(_PETRI_LOG, "a") as _f:
        _f.write(json.dumps(rec, default=repr) + "\\n")
"""


# ---------------------------------------------------------------------------
# AST instrumentation
# ---------------------------------------------------------------------------

class Instrumenter(ast.NodeTransformer):
    """Wrap every module-level assignment with a recorder call.

    target:

        x = <value>

    becomes:

        x = <value>
        __lab_record("x", x)
    """

    def visit_Assign(self, node):
        super().generic_visit(node)  # transform nested exprs first
        calls = []
        for target in node.targets:
            if isinstance(target, ast.Name):
                call = ast.Expr(
                    value=ast.Call(
                        func=ast.Name(id="__lab_record", ctx=ast.Load()),
                        args=[ast.Constant(value=target.id),
                              ast.Name(id=target.id, ctx=ast.Load())],
                        keywords=[],
                    )
                )
                ast.copy_location(call, target)
                calls.append(call)
        if not calls:
            return node
        return [node] + calls

    def visit_AnnAssign(self, node):
        # x: int = 10  -> still an assignment we care about
        if node.value is None:
            return node
        self.generic_visit(node)
        if isinstance(node.target, ast.Name):
            call = ast.Expr(
                value=ast.Call(
                    func=ast.Name(id="__lab_record", ctx=ast.Load()),
                    args=[ast.Constant(value=node.target.id),
                          ast.Name(id=node.target.id, ctx=ast.Load())],
                    keywords=[],
                )
            )
            ast.copy_location(call, node)
            return [node, call]
        return node


def instrument_source(source):
    """Parse source, instrument top-level assignments, return new source."""
    tree = ast.parse(source)
    tree = Instrumenter().visit(tree)
    ast.fix_missing_locations(tree)
    return ast.unparse(tree)


# ---------------------------------------------------------------------------
# Running a program
# ---------------------------------------------------------------------------

def run_program(path, extra_args=None, track=None, ignore=None):
    """Run `path` in a real subprocess, return (history, duration_seconds, failed).

    The instrumented program runs as its own `python <path>` subprocess so
    os._exit, quit and sys.argv all behave exactly like a normal invocation.
    The subprocess records each change to a JSONL log (via PETRI_LOG); we read
    the log back and rebuild the per-variable history with millisecond
    timestamps. `track`/`ignore` are lists of name patterns (supports `*`) that
    filter which variables are recorded.
    """
    with open(path) as fh:
        source = fh.read()
    instrumented = PRELUDE + "\n" + instrument_source(source)

    temp_runner = _write_runner(instrumented, path)
    log_path = _temp_log_path()
    extra_args = extra_args or []

    env = dict(os.environ)
    env["PETRI_LOG"] = log_path
    env["PETRI_PROGRAM"] = os.path.abspath(path)
    env["PETRI_ARGS"] = json.dumps(extra_args)
    env["PETRI_START"] = str(time.monotonic())
    env["PETRI_TRACK"] = json.dumps(track or [])
    env["PETRI_IGNORE"] = json.dumps(ignore or [])

    start = time.monotonic()
    try:
        proc = subprocess.run(
            [sys.executable, temp_runner],
            env=env,
            cwd=os.path.dirname(os.path.abspath(path)) or None,
        )
    finally:
        duration = time.monotonic() - start
        if os.path.exists(temp_runner):
            os.remove(temp_runner)

    failed = proc.returncode != 0
    history = _read_history(log_path)
    if os.path.exists(log_path):
        os.remove(log_path)
    return history, duration, failed


def _write_runner(instrumented, path):
    """Write the instrumented source to a temp .py the subprocess will exec."""
    import tempfile
    fd, temp_runner = tempfile.mkstemp(prefix="petri-", suffix=".py",
                                        dir=os.path.dirname(os.path.abspath(path)),
                                        text=True)
    with os.fdopen(fd, "w") as fh:
        fh.write(instrumented)
    return temp_runner


def _temp_log_path():
    import tempfile
    fd, path = tempfile.mkstemp(prefix="petri-log-", suffix=".jsonl", text=True)
    os.close(fd)
    os.remove(path)
    return path


def _read_history(log_path):
    """Rebuild {name: [ {value, t_ms}, ... ]} from the JSONL log lines."""
    history = {}
    try:
        with open(log_path) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                rec = json.loads(line)
                rec.setdefault("t", 0.0)
                history.setdefault(rec["n"], []).append(rec)
    except (OSError, ValueError):
        return {}
    return history


# ---------------------------------------------------------------------------
# Storage (JSON files + index)
# ---------------------------------------------------------------------------

def current_run_number():
    if not os.path.isdir(RUNS_DIR):
        return 1
    numbers = []
    for fn in os.listdir(RUNS_DIR):
        try:
            numbers.append(int(fn.split("-")[0]))
        except (ValueError, IndexError):
            continue
    return (max(numbers) + 1) if numbers else 1


def save_run(program, duration, history, failed=False, well=None):
    os.makedirs(RUNS_DIR, exist_ok=True)
    number = current_run_number()
    run_id = uuidmod.uuid4().hex
    filename = "{}-{}.json".format(number, run_id)
    run = {
        "number": number,
        "uuid": run_id,
        "program": program,
        "well": well,
        "start": datetime.datetime.now().isoformat(timespec="seconds"),
        "duration": duration,
        "failed": failed,
        "variables": history,
        "variable_count": sum(len(v) for v in history.values()),
    }
    path = os.path.join(RUNS_DIR, filename)
    with open(path, "w") as fh:
        json.dump(run, fh, indent=2)
    return number, path


def load_run(number):
    path = os.path.join(RUNS_DIR, "{}-*.json".format(number))
    import glob
    matches = glob.glob(path)
    if not matches:
        return None
    with open(matches[0]) as fh:
        return json.load(fh)


def all_runs():
    if not os.path.isdir(RUNS_DIR):
        return []
    runs = []
    for fn in os.listdir(RUNS_DIR):
        if not fn.endswith(".json"):
            continue
        with open(os.path.join(RUNS_DIR, fn)) as fh:
            runs.append(json.load(fh))
    runs.sort(key=lambda r: r["number"])
    return runs


# ---------------------------------------------------------------------------
# Display
# ---------------------------------------------------------------------------

def fmt_seconds(seconds):
    return "{:.2f}s".format(seconds)


def fmt_value(snap, max_len=60):
    def render(s, depth=0):
        t = s["type"]
        v = s["value"]
        if t in ("int", "float", "str", "bool", "None"):
            return json.dumps(v, ensure_ascii=False)
        if t == "list":
            return "[" + ", ".join(render(x, depth + 1) for x in v) + "]"
        if t == "dict":
            inner = ", ".join("{}: {}".format(json.dumps(k, ensure_ascii=False), render(x, depth + 1)) for k, x in v.items())
            return "{" + inner + "}"
        return repr(v)
    text = render(snap)
    if len(text) > max_len:
        text = text[:max_len - 3] + "..."
    return text


def print_run_summary(run, well=None):
    tag = " [FAILED]" if run.get("failed") else ""
    print("Culture #{}{}".format(run["number"], tag))
    if well:
        print("Well: {}".format(well))
    print("Program: {}".format(run["program"]))
    print("Duration: {}".format(fmt_seconds(run["duration"])))
    print("Variables recorded: {}".format(run["variable_count"]))
    print()


def print_runs(runs):
    if not runs:
        print("No cultures yet. Run 'petri culture <program.py>' to grow one.")
        return
    header = "{:<4} {:<14} {:<12} {:<10} {:<10}".format("ID", "Well", "Program", "Date", "Duration")
    print(header)
    print("-" * len(header))
    for r in runs:
        date = r["start"][:10]
        failmark = "  (failed)" if r.get("failed") else ""
        well = r.get("well") or "-"
        print("{:<4} {:<14} {:<12} {:<10} {:<10}{}".format(
            r["number"], well, r["program"], date, fmt_seconds(r["duration"]), failmark))


def print_inspect(run):
    print("Culture #{}".format(run["number"]))
    print("Program: {}".format(run["program"]))
    print()
    print("Variables")
    print("-" * 30)
    history = run.get("variables", {})
    if not history:
        print("(no variables recorded)")
        return
    for name, snaps in history.items():
        print(name)
        for snap in snaps:
            t = snap.get("t", 0.0)
            print("  [{:>7.1f}ms] {}".format(t, fmt_value(snap.get("v", snap))))


def diff_histories(a, b):
    """Compare two value histories (list of record dicts). Returns (changed_lines, status).

    status: "changed" if any position differs, else "unchanged" (including
    when histories are empty/equal in length and equal in value).
    """
    changed = []
    n = max(len(a), len(b))
    changed_any = False
    for i in range(n):
        av = a[i] if i < len(a) else None
        bv = b[i] if i < len(b) else None
        av_val = av.get("v") if isinstance(av, dict) else av
        bv_val = bv.get("v") if isinstance(bv, dict) else bv
        if av_val == bv_val:
            continue
        changed_any = True
        if av_val is not None and bv_val is not None and _same_container_type(av_val, bv_val):
            sub = deep_value_diff(av_val, bv_val)
            if sub:
                changed.append(", ".join(sub))
            else:
                changed.append("{} → {}".format(fmt_value(av_val), fmt_value(bv_val)))
        else:
            left = fmt_value(av_val) if av_val is not None else "(none)"
            right = fmt_value(bv_val) if bv_val is not None else "(none)"
            changed.append("{} → {}".format(left, right))
    return changed, ("changed" if changed_any else "unchanged")


def _same_container_type(x, y):
    return x.get("type") in ("list", "dict") and x.get("type") == y.get("type")


def deep_value_diff(a, b, path=""):
    """Return lines describing fine-grained differences inside list/dict values.

    `a`, `b` are typed snapshots (dicts with "type"/"value"). Produces lines
    like "config['lr']: 0.1 → 0.01" or "items[1]: 2 → 9".
    """
    if a["type"] == "list" and b["type"] == "list":
        out = []
        n = max(len(a["value"]), len(b["value"]))
        for i in range(n):
            av = a["value"][i] if i < len(a["value"]) else None
            bv = b["value"][i] if i < len(b["value"]) else None
            if av == bv:
                continue
            at = av or {"type": "repr", "value": "(none)"}
            bt = bv or {"type": "repr", "value": "(none)"}
            if av is not None and bv is not None and _same_container_type(av, bv):
                inner = deep_value_diff(av, bv, path="")
                if inner:
                    out.append("{}[{}] {{{}}}".format(path, i, ", ".join(inner)))
                    continue
            out.append("{}[{}]: {} → {}".format(path, i, fmt_value(at), fmt_value(bt)))
        return out
    if a["type"] == "dict" and b["type"] == "dict":
        out = []
        keys = list(a["value"].keys())
        for k in b["value"].keys():
            if k not in keys:
                keys.append(k)
        for k in keys:
            av = a["value"].get(k)
            bv = b["value"].get(k)
            if av == bv:
                continue
            at = av or {"type": "repr", "value": "(none)"}
            bt = bv or {"type": "repr", "value": "(none)"}
            if _same_container_type(at, bt):
                inner = deep_value_diff(at, bt)
                if inner:
                    out.append("{}{} {{{}}}".format(path, k, ", ".join(inner)))
                    continue
            out.append("{}{}: {} → {}".format(path, k, fmt_value(at), fmt_value(bt)))
        return out
    return []


def print_compare(run_a, run_b):
    print("Gram stain of Culture #{} vs Culture #{}".format(run_a["number"], run_b["number"]))
    print()

    ha = run_a.get("variables", {})
    hb = run_b.get("variables", {})

    changed_vars = {}
    unchanged_vars = {}
    added = {}
    removed = {}

    for name in ha:
        if name in hb:
            lines, status = diff_histories(ha[name], hb[name])
            if status == "changed":
                changed_vars[name] = lines
            else:
                unchanged_vars[name] = ha[name][-1]["v"]
        else:
            removed[name] = ha[name][-1]["v"]

    for name in hb:
        if name not in ha:
            added[name] = hb[name][-1]["v"]

    print("Gram-positive (changed)")
    print("-" * 30)
    if not changed_vars:
        print("(none)")
    else:
        for name, lines in changed_vars.items():
            print(name)
            for line in lines:
                print("  {}".format(line))
    print()

    print("Gram-negative (unchanged)")
    print("-" * 30)
    if not unchanged_vars:
        print("(none)")
    else:
        for name, snap in unchanged_vars.items():
            print("{} = {}".format(name, fmt_value(snap)))
    print()

    print("Added")
    print("-" * 30)
    if not added:
        print("(none)")
    else:
        for name, snap in added.items():
            print("{} = {}".format(name, fmt_value(snap)))
    print()

    print("Removed")
    print("-" * 30)
    if not removed:
        print("(none)")
    else:
        for name, snap in removed.items():
            print("{}".format(name))


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def cmd_culture(args):
    if len(args) < 1:
        print("usage: petri culture <program.py> [--well NAME] [--track N] [--ignore N]")
        return 1
    program = args[0]
    if not os.path.isfile(program):
        print("error: petri culture: no such file: {}".format(program))
        return 1

    well, track, ignore = None, [], []
    i = 1
    while i < len(args):
        a = args[i]
        if a == "--well" and i + 1 < len(args):
            well = args[i + 1]
            i += 2
        elif a.startswith("--well="):
            well = a.split("=", 1)[1]
            i += 1
        elif a == "--track" and i + 1 < len(args):
            track.extend(args[i + 1].split(","))
            i += 2
        elif a.startswith("--track="):
            track.extend(a.split("=", 1)[1].split(","))
            i += 1
        elif a == "--ignore" and i + 1 < len(args):
            ignore.extend(args[i + 1].split(","))
            i += 2
        elif a.startswith("--ignore="):
            ignore.extend(a.split("=", 1)[1].split(","))
            i += 1
        else:
            i += 1

    print("Growing {}...".format(program))
    history, duration, failed = run_program(program, track=track, ignore=ignore)
    number, path = save_run(os.path.basename(program), duration, history,
                            failed, well=well)

    print()
    print_run_summary({
        "number": number,
        "program": os.path.basename(program),
        "duration": duration,
        "variable_count": sum(len(v) for v in history.values()),
    }, well)
    print("Culture saved.")
    return 1 if failed else 0


def cmd_batch(args):
    program = None
    times = 10
    well = None
    track, ignore = [], []
    i = 0
    while i < len(args):
        a = args[i]
        if a == "--times":
            try:
                times = int(args[i + 1])
            except (IndexError, ValueError):
                print("error: --times needs an integer")
                return 1
            i += 2
            continue
        if a.startswith("--times="):
            try:
                times = int(a.split("=", 1)[1])
            except ValueError:
                print("error: --times needs an integer")
                return 1
            i += 1
        elif a == "--well" and i + 1 < len(args):
            well = args[i + 1]
            i += 2
        elif a.startswith("--well="):
            well = a.split("=", 1)[1]
            i += 1
        elif a == "--track" and i + 1 < len(args):
            track.extend(args[i + 1].split(","))
            i += 2
        elif a.startswith("--track="):
            track.extend(a.split("=", 1)[1].split(","))
            i += 1
        elif a == "--ignore" and i + 1 < len(args):
            ignore.extend(args[i + 1].split(","))
            i += 2
        elif a.startswith("--ignore="):
            ignore.extend(a.split("=", 1)[1].split(","))
            i += 1
        else:
            program = a
            i += 1

    if not program:
        print("usage: petri batch <program.py> [--times N] [--well NAME] [--track N] [--ignore N]")
        return 1
    if not os.path.isfile(program):
        print("error: petri batch: no such file: {}".format(program))
        return 1

    print("Culturing {} {} time(s)".format(program, times))
    results = []
    exit_code = 0
    for n in range(1, times + 1):
        print("\rpetri is culturing... [culture {}/{}]".format(n, times), end="", flush=True)
        history, duration, failed = run_program(program, track=track, ignore=ignore)
        run_well = well if well else None
        num, path = save_run(os.path.basename(program), duration, history,
                             failed, well=run_well)
        if failed:
            exit_code = 1
        results.append((num, duration, sum(len(v) for v in history.values())))

    print()
    print()
    print("{} culture(s) saved.".format(len(results)))
    for num, dur, vc in results:
        print("  #{}  {}  {}".format(num, fmt_seconds(dur), vc))
    return exit_code


def cmd_plate(args):
    runs = all_runs()
    if args and (args[0] == "--well" or args[0].startswith("--well=")):
        if args[0].startswith("--well="):
            well = args[0].split("=", 1)[1]
        else:
            well = args[1] if len(args) > 1 else None
        if well is not None:
            runs = [r for r in runs if r.get("well") == well]
    print_runs(runs)


def cmd_scope(args):
    if len(args) < 1:
        print("usage: petri scope <run number>")
        return 1
    try:
        number = int(args[0])
    except ValueError:
        print("error: petri scope: run number must be an integer")
        return 1
    run = load_run(number)
    if not run:
        print("error: petri scope: no run #{}".format(number))
        return 1
    print_inspect(run)


def cmd_gram(args):
    if len(args) < 2:
        print("usage: petri gram <run number A> <run number B>")
        return 1
    try:
        a = int(args[0])
        b = int(args[1])
    except ValueError:
        print("error: petri gram: run numbers must be integers")
        return 1
    run_a = load_run(a)
    run_b = load_run(b)
    if not run_a or not run_b:
        print("error: petri gram: one or both runs not found ({} / {})".format(a, b))
        return 1
    print_compare(run_a, run_b)


def cmd_sterilize(args):
    if not os.path.isdir(RUNS_DIR):
        print("nothing to sterilize: no cultures exist")
        return 0

    n = len(all_runs())
    print("This will permanently delete all {} saved culture(s).".format(n))

    for _ in range(2):
        answer = input('Type "yes" to confirm: ').strip().lower()
        if answer != "yes":
            print("aborted.")
            return 1

    for fn in os.listdir(RUNS_DIR):
        p = os.path.join(RUNS_DIR, fn)
        if os.path.isfile(p):
            os.remove(p)
    os.rmdir(RUNS_DIR)
    print("All {} culture(s) sterilized.".format(n))
    return 0


def cmd_incubate(args):
    if len(args) < 2:
        print("usage: petri incubate <program.py> <limit-ms>")
        return 1
    program, limit_str = args[0], args[1]
    if not os.path.isfile(program):
        print("error: petri incubate: no such file: {}".format(program))
        return 1
    try:
        limit_ms = int(limit_str)
    except ValueError:
        print("error: petri incubate: limit must be an integer (milliseconds)")
        return 1

    RED = "\033[0;31m"
    GREEN = "\033[0;32m"
    RESET = "\033[0m"

    start = time.monotonic()
    try:
        result = subprocess.run(
            [sys.executable, program], capture_output=True, text=True
        )
    except OSError as e:
        print("error: petri incubate: could not run: {}".format(e))
        return 1
    elapsed_ms = (time.monotonic() - start) * 1000
    diff_ms = elapsed_ms - limit_ms

    if result.returncode != 0:
        print("{} failed to run (exit {}):{}".format(
            program, result.returncode,
            (result.stderr if result.stderr.strip() else " no output")))
        sys.stdout.write(result.stdout)
        print("{}ran in {:.0f} ms (limit {} ms){}".format(RED, elapsed_ms, limit_ms, RESET))
        return 1

    if elapsed_ms <= limit_ms:
        print("{}ran in {:.0f} ms (limit {} ms) — {:.0f} ms under{}".format(
            GREEN, elapsed_ms, limit_ms, limit_ms - elapsed_ms, RESET))
        return 0
    else:
        print("{}ran in {:.0f} ms (limit {} ms) — {:.0f} ms over{}".format(
            RED, elapsed_ms, limit_ms, elapsed_ms - limit_ms, RESET))
        return 1


def main(argv):
    if not argv:
        print("""petri - grow, observe, compare

usage:
  petri culture <program.py> [--well NAME] [--track N] [--ignore N]  grow a run (optionally into a well, filter vars)
  petri batch <program.py> [--times N] [--well NAME] [--track N] [--ignore N]
                                                grow N runs (default 10)
  petri plate [--well NAME]                     list cultures (filter by well)
  petri scope <run>                             observe a culture's variable history
  petri gram <runA> <runB>                      differential test (diff) two cultures
  petri incubate <program.py> <limit-ms>        time a run against a limit (ms)
  petri sterilize                               delete all cultures (confirm twice)

help:
  petri help""")
        return 0

    cmd = argv[0]
    rest = argv[1:]

    if cmd == "help":
        return main([])
    if cmd == "culture":
        return cmd_culture(rest)
    if cmd == "batch":
        return cmd_batch(rest)
    if cmd == "plate":
        return cmd_plate(rest)
    if cmd == "scope":
        return cmd_scope(rest)
    if cmd == "gram":
        return cmd_gram(rest)
    if cmd == "sterilize":
        return cmd_sterilize(rest)
    if cmd == "incubate":
        return cmd_incubate(rest)

    print("unknown command: {}".format(cmd))
    return main([])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
