        return 1
    program, limit_str = args[0], args[1]
    if not os.path.isfile(program):
        print("error: petri incubate: no such file: {}".format(program))
        return 1
    try:
        limit_ms = int(limit_str)
    except ValueError:
        print("error: petri incubate: limit must be an integer (milliseconds)")
        return 1

    RED = "\033[0;31m"
    GREEN = "\033[0;32m"
    RESET = "\033[0m"

    start = time.monotonic()
    try:
        result = subprocess.run(
            [sys.executable, program], capture_output=True, text=True
        )
    except OSError as e:
        print("error: petri incubate: could not run: {}".format(e))
        return 1
    elapsed_ms = (time.monotonic() - start) * 1000
    diff_ms = elapsed_ms - limit_ms

    if result.returncode != 0:
        print("{} failed to run (exit {}):{}".format(
            program, result.returncode,
            (result.stderr if result.stderr.strip() else " no output")))
        sys.stdout.write(result.stdout)
        print("{}ran in {:.0f} ms (limit {} ms){}".format(RED, elapsed_ms, limit_ms, RESET))
        return 1

    if elapsed_ms <= limit_ms:
        print("{}ran in {:.0f} ms (limit {} ms) — {:.0f} ms under{}".format(
            GREEN, elapsed_ms, limit_ms, limit_ms - elapsed_ms, RESET))
        return 0
    else:
        print("{}ran in {:.0f} ms (limit {} ms) — {:.0f} ms over{}".format(
            RED, elapsed_ms, limit_ms, elapsed_ms - limit_ms, RESET))
        return 1


def cmd_evolve(args):
    """Update petri to the latest version in place."""
    self_path = os.path.abspath(sys.argv[0])
    my_version = _parse_version(VERSION)

    # find the latest release
    latest = latest_version()
    if not latest:
        print("could not reach the substrate feed — check your network connection")
        return 1
    # normalize the tag to a bare URL-safe tag (e.g. 'v0.3.1')
    latest_tag = latest.strip().strip("+")
    if not latest_tag.startswith("v"):
        latest_tag = "v" + latest_tag
    if _parse_version(latest) <= my_version:
        print("your culture is already the latest strain (petri {}).".format(VERSION))
        return 0

    target = os.path.realpath(self_path)
    if not os.access(target, os.W_OK):
        print("petri {} → {} available.".format(VERSION, latest))
        print("this install is not writable — rerun with:  sudo petri evolve")
        return 1

    print("evolving petri {} → {} ...".format(VERSION, latest))
    try:
        with urllib.request.urlopen(tag_download_url(latest_tag), timeout=15) as r:
            new_body = r.read()
    except Exception as e:
        print("download failed: {}".format(e))
        return 1
    # sanity check: the fetched binary should carry a version newer than ours,
    # otherwise the CDN served us stale bytes and we shouldn't clobber the file
    fetched_version = _body_version(new_body)
    if _parse_version(fetched_version) <= my_version:
        print("downloaded strain looks stale (petri {}); try again shortly.".format(
            fetched_version or "?"))
        return 1

    tmp = target + ".new"
    try:
        with open(tmp, "wb") as fh:
            fh.write(new_body)
        os.chmod(tmp, os.stat(target).st_mode)
        os.replace(tmp, target)
    except OSError as e:
        print("could not write update: {}".format(e))
        return 1
    print("evolved! you are now running petri {}.".format(latest))
    print("note: run '{} --version' to confirm.".format(target))
    return 0


def main(argv):
    if not argv:
        print("""petri - grow, observe, compare

usage:
  petri agar [status] [path] [export <dest.tar>] [import <arch.tar>]  manage the workspace
  petri culture <program.py> [--well NAME] [--track N] [--ignore N]  grow a run
  petri batch <program.py> [--times N] [--well NAME] [--track N] [--ignore N]  grow N runs (default 10)
  petri plate [--well NAME]                     list cultures (filter by well)
  petri scope <run>                             observe a culture's variable history
  petri gram <runA> <runB>                      differential test (diff) two cultures
  petri cfu <runA> <runB>                       numeric change measure per variable
  petri incubate <program.py> <limit-ms>        time a run against a limit (ms)
  petri sterilize                               delete all cultures (confirm twice)
  petri evolve                                  update petri to the latest version
  petri --version                               print version

help:
  petri help""")
        return 0

    cmd = argv[0]
    rest = argv[1:]

    if cmd in ("--version", "-V", "version"):
        print("petri {}".format(VERSION))
        # if a newer release exists, surface the update warning + what's new
        if not os.environ.get("PETRI_NO_UPDATE"):
            _version_update_hint()
        return 0

    if cmd == "help":
        return main([])
    if cmd == "evolve":
        return cmd_evolve(rest)

    # on every real command, warn if petri is outdated
    check_for_update()

    if cmd == "agar":
        return cmd_agar(rest)
    if cmd == "culture":
        return cmd_culture(rest)
    if cmd == "batch":
        return cmd_batch(rest)
    if cmd == "plate":
        return cmd_plate(rest)
    if cmd == "scope":
        return cmd_scope(rest)
    if cmd == "gram":
        return cmd_gram(rest)
    if cmd == "cfu":
        return cmd_cfu(rest)
    if cmd == "sterilize":
        return cmd_sterilize(rest)
    if cmd == "incubate":
        return cmd_incubate(rest)

    print("unknown command: {}".format(cmd))
    return main([])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
